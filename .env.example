# Frontend Environment Variables Configuration

# Set this to the live backend server URL (including the /api/v1 prefix)
# Example: VITE_API_URL=https://api.yourdomain.com/api/v1 or http://18.xxx.xxx.xxx:5000/api/v1
# In Vercel, add this key-value pair under your Project Settings -> Environment Variables.
VITE_API_URL=http://localhost:5000/api/v1
